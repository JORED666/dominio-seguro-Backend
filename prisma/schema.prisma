generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                String                  @id @default(uuid())
  nombre            String
  correo            String                  @unique
  passwordHash      String                  @map("password_hash")
  rol               String                  @default("usuario")
  mfaSecreto        String?                 @map("mfa_secreto")
  mfaActivo         Boolean                 @default(false) @map("mfa_activo")
  mfaUltimoPaso     Int?                    @map("mfa_ultimo_paso")
  googleId          String?                 @unique @map("google_id")
  creadoEn          DateTime                @default(now()) @map("creado_en")
  dominios          Dominio[]
  refrescos         TokenRefresco[]
  restablecimientos TokenRestablecimiento[]

  @@map("usuarios")
}

model TokenRefresco {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  familia   String
  hash      String    @unique
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  creadoEn  DateTime  @default(now()) @map("creado_en")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([familia])
  @@map("tokens_refresco")
}

// Enlace de un solo uso para restablecer la contraseña: solo se guarda el hash del token
model TokenRestablecimiento {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  hash      String    @unique
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  creadoEn  DateTime  @default(now()) @map("creado_en")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_restablecimiento")
}

model Dominio {
  id                String     @id @default(uuid())
  usuarioId         String     @map("usuario_id")
  nombreDominio     String     @map("nombre_dominio")
  ultimoPuntaje     Int?       @map("ultimo_puntaje")
  tokenVerificacion String?    @map("token_verificacion")
  verificadoEn      DateTime?  @map("verificado_en")
  creadoEn          DateTime   @default(now()) @map("creado_en")
  usuario           Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  analisis          Analisis[]
  similares         Similar[]

  @@unique([usuarioId, nombreDominio])
  @@map("dominios")
}

model Analisis {
  id         String     @id @default(uuid())
  dominioId  String     @map("dominio_id")
  fecha      DateTime   @default(now())
  puntaje    Int
  duracionMs Int        @map("duracion_ms")
  categorias Json?
  dominio    Dominio    @relation(fields: [dominioId], references: [id], onDelete: Cascade)
  hallazgos  Hallazgo[]

  @@index([dominioId, fecha])
  @@map("analisis")
}

model Hallazgo {
  id            String   @id @default(uuid())
  analisisId    String   @map("analisis_id")
  categoria     String
  severidad     String
  titulo        String
  descripcion   String
  recomendacion String
  analisis      Analisis @relation(fields: [analisisId], references: [id], onDelete: Cascade)

  @@map("hallazgos")
}

// Variantes parecidas al dominio (typosquatting) y lo que el usuario decidió de cada una
model Similar {
  id             String    @id @default(uuid())
  dominioId      String    @map("dominio_id")
  nombre         String
  tecnica        String
  estado         String
  riesgo         String
  conCorreo      Boolean   @map("con_correo")
  conCertificado Boolean   @map("con_certificado")
  propio         Boolean   @default(false)
  revisado       Boolean   @default(false)
  detectadoEn    DateTime? @map("detectado_en")
  verificadoEn   DateTime  @default(now()) @map("verificado_en")
  dominio        Dominio   @relation(fields: [dominioId], references: [id], onDelete: Cascade)

  @@unique([dominioId, nombre])
  @@map("similares")
}
