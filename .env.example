# Copia este archivo como .env y ajusta los valores
DATABASE_URL="postgresql://dominio:dominio_dev@localhost:5432/dominio_seguro?schema=public"
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"
PORT=3000
CORS_ORIGIN="http://localhost:4200"

# API de reputación de IP (proyecto del profe, ver su README)
IPSCORE_URL=http://localhost:8000
IPSCORE_API_KEY=

# Exigir DNS TXT antes de analizar un dominio (pon false solo para probar con dominios ajenos)
EXIGIR_VERIFICACION=true

# Clave AES-256 (64 hex) para cifrar datos sensibles en reposo. Genera: openssl rand -hex 32
CIFRADO_KEY=

# Correo de alertas. Sin SMTP_HOST, en desarrollo los correos van a una bandeja de pruebas (Ethereal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_DE="Dominio Seguro <alertas@tudominio.com>"
# Dirección del panel que aparece en los correos
PANEL_URL=http://localhost:4200
# Revisión automática de dominios (cron, hora de Ciudad de México). Por defecto: todos los días a las 7:00
REVISION_CRON=0 7 * * *
REVISION_ACTIVA=true

# Intentos por 15 min en /api/auth (por defecto 20; subirlo solo para pruebas de carga o ZAP)
# LIMITE_AUTH=20

# Solo para docker compose: debe ser la misma contraseña de DATABASE_URL
# POSTGRES_PASSWORD=
# ORIGEN_PUBLICO=http://localhost:8080
# TRUST_PROXY=1 (detras de Nginx)
